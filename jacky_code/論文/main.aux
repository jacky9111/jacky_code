\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Safe-release candidate graph between critical safe beams and helper release beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm  {safe}}$ denote safe beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm  {rls}}$ denote helper release beam candidates. An edge $e=(b_{s,\ell }^{\mathrm  {safe}},b_{h,k}^{\mathrm  {rls}})$ exists when the two beams have footprint overlap.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:ch4_safe_release_graph}{{3}{7}{Safe-release candidate graph between critical safe beams and helper release beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm {safe}}$ denote safe beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm {rls}}$ denote helper release beam candidates. An edge $e=(b_{s,\ell }^{\mathrm {safe}},b_{h,k}^{\mathrm {rls}})$ exists when the two beams have footprint overlap}{figure.3}{}}
