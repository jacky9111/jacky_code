\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Three time slots as the along-track LEO satellites ($s^{\mathrm  {N}}$, $s^{\mathrm  {c}}$, and $s^{\mathrm  {S}}$) pass the protected GSO ground station. In region $S_{\mathrm  {C}}$ on the critical satellite, black-hatched beams are $\mathcal  {B}_c^{\mathrm  {off}}(t)$ (closed beams) and green-hatched beams are $\mathcal  {B}_c^{\mathrm  {safe}}(t)$ (safe beams). Panels (a)--(c) show earlier to later time slots.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:ch4_beam_relation_record}{{3}{5}{Three time slots as the along-track LEO satellites ($s^{\mathrm {N}}$, $s^{\mathrm {c}}$, and $s^{\mathrm {S}}$) pass the protected GSO ground station. In region $S_{\mathrm {C}}$ on the critical satellite, black-hatched beams are $\mathcal {B}_c^{\mathrm {off}}(t)$ (closed beams) and green-hatched beams are $\mathcal {B}_c^{\mathrm {safe}}(t)$ (safe beams). Panels (a)--(c) show earlier to later time slots}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}Safe-Beam Assisted Helper Relief}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Beam-pair mapping tables at time slot $t$. (a) $\mathcal  {M}_{\mathrm  {safe}\to \mathrm  {rel}}(t)$: critical safe beams on $s^{\mathrm  {c}}$ mapped to helper release beams on $s^{\mathrm  {N}}$/$s^{\mathrm  {S}}$ (SAHR). (b) $\mathcal  {M}_{\mathrm  {off}\to \mathrm  {relay}}(t)$: critical closed beams mapped to helper relay beams (BPLR).}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:ch4_beam_pair_mapping}{{4}{6}{Beam-pair mapping tables at time slot $t$. (a) $\mathcal {M}_{\mathrm {safe}\to \mathrm {rel}}(t)$: critical safe beams on $s^{\mathrm {c}}$ mapped to helper release beams on $s^{\mathrm {N}}$/$s^{\mathrm {S}}$ (SAHR). (b) $\mathcal {M}_{\mathrm {off}\to \mathrm {relay}}(t)$: critical closed beams mapped to helper relay beams (BPLR)}{figure.4}{}}
