\@writefile{toc}{\contentsline {section}{\numberline {IV}Method}{1}{section.4}\protected@file@percent }
\newlabel{sec:chapter4}{{IV}{1}{Method}{section.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-A}}Method Overview}{1}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Time-Slot Beam Relation Record}{1}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three time slots as the along-track LEO satellites ($s^{\mathrm  {N}}$, $s^{\mathrm  {c}}$, and $s^{\mathrm  {S}}$) pass the protected GSO ground station. In region $S_{\mathrm  {C}}$ on the critical satellite, black-hatched beams are $\mathcal  {B}_c^{\mathrm  {off}}(t)$ (closed beams) and green-hatched beams are $\mathcal  {B}_c^{\mathrm  {safe}}(t)$ (safe beams). Panels (a)--(c) show earlier to later time slots.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:ch4_beam_relation_record}{{1}{2}{Three time slots as the along-track LEO satellites ($s^{\mathrm {N}}$, $s^{\mathrm {c}}$, and $s^{\mathrm {S}}$) pass the protected GSO ground station. In region $S_{\mathrm {C}}$ on the critical satellite, black-hatched beams are $\mathcal {B}_c^{\mathrm {off}}(t)$ (closed beams) and green-hatched beams are $\mathcal {B}_c^{\mathrm {safe}}(t)$ (safe beams). Panels (a)--(c) show earlier to later time slots}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}Safe-Beam Assisted Helper Relief}{2}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Beam-pair mapping tables at time slot $t$. (a) $\mathcal  {M}_{\mathrm  {safe}\to \mathrm  {rel}}(t)$: critical safe beams on $s^{\mathrm  {c}}$ mapped to helper release beams on $s^{\mathrm  {N}}$/$s^{\mathrm  {S}}$ (SAHR). (b) $\mathcal  {M}_{\mathrm  {off}\to \mathrm  {relay}}(t)$: critical closed beams mapped to helper relay beams (BPLR).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:ch4_beam_pair_mapping}{{2}{3}{Beam-pair mapping tables at time slot $t$. (a) $\mathcal {M}_{\mathrm {safe}\to \mathrm {rel}}(t)$: critical safe beams on $s^{\mathrm {c}}$ mapped to helper release beams on $s^{\mathrm {N}}$/$s^{\mathrm {S}}$ (SAHR). (b) $\mathcal {M}_{\mathrm {off}\to \mathrm {relay}}(t)$: critical closed beams mapped to helper relay beams (BPLR)}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Helper Relay Beam Boosting}{3}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-E}}Beam-Pair Local Relay}{3}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Illustration of Safe-Beam Assisted Helper Relief (SAHR). Critical safe beams take over eligible helper users from helper release beams, and the released power is returned to the helper satellite power pool.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:ch4_Safe-beam_assisted_power_release}{{3}{4}{Illustration of Safe-Beam Assisted Helper Relief (SAHR). Critical safe beams take over eligible helper users from helper release beams, and the released power is returned to the helper satellite power pool}{figure.3}{}}
