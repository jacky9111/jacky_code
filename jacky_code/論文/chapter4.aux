\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Safe-release candidate graph between critical safe beams and helper release beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm  {safe}}$ denote safe beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm  {rls}}$ denote helper release beam candidates. An edge $e=(b_{s,\ell }^{\mathrm  {safe}},b_{h,k}^{\mathrm  {rls}})$ exists when the two beams have footprint overlap.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:ch4_safe_release_graph}{{4}{3}{Safe-release candidate graph between critical safe beams and helper release beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm {safe}}$ denote safe beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm {rls}}$ denote helper release beam candidates. An edge $e=(b_{s,\ell }^{\mathrm {safe}},b_{h,k}^{\mathrm {rls}})$ exists when the two beams have footprint overlap}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Closed-recovery candidate graph between critical closed beams and helper recovery beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm  {off}}$ denote closed beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm  {rec}}$ denote helper recovery beam candidates. An edge $e=(b_{s,\ell }^{\mathrm  {off}},b_{h,k}^{\mathrm  {rec}})$ exists when the two beams have footprint overlap.}}{3}{figure.5}\protected@file@percent }
\newlabel{fig:ch4_closed_recovery_graph}{{5}{3}{Closed-recovery candidate graph between critical closed beams and helper recovery beam candidates. The left-side nodes $b_{s,\ell }^{\mathrm {off}}$ denote closed beams on critical satellites, and the right-side nodes $b_{h,k}^{\mathrm {rec}}$ denote helper recovery beam candidates. An edge $e=(b_{s,\ell }^{\mathrm {off}},b_{h,k}^{\mathrm {rec}})$ exists when the two beams have footprint overlap}{figure.5}{}}
