\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Example of iterative edge activation and graph update in HBR. Green edges denote selected closed-recovery relations. After selected closed-beam users are reassociated to helper recovery beams, the available helper power and remaining unrecovered users are updated, and the recovery scores of the remaining candidate edges are recalculated.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:ch4_hbr_iterative_update}{{5}{5}{Example of iterative edge activation and graph update in HBR. Green edges denote selected closed-recovery relations. After selected closed-beam users are reassociated to helper recovery beams, the available helper power and remaining unrecovered users are updated, and the recovery scores of the remaining candidate edges are recalculated}{figure.5}{}}
\newlabel{eq:ch4_hbr_score}{{2}{5}{Helper-Beam Reassociation for Closed-Beam Users}{equation.2}{}}
